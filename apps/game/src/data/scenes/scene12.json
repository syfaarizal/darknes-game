{
    "meta": {
        "id": "scene12",
        "title": "Keadilan Terhidang",
        "background": "mansion",
        "entry": "scene12_n001"
    },
    "nodes": [
        {
            "id": "scene12_n001",
            "type": "narration",
            "text": "Pagi datang. Sinar matahari menembus jendela mansion Ravenscroft yang sudah lama tidak melihat cahaya.",
            "next": "scene12_n002"
        },
        {
            "id": "scene12_n002",
            "type": "narration",
            "text": "Azaroth ditahan di sel bawah tanahnya sendiri. Bukan di sel biasa — di ruang kerja ayah {playerName} dulu. Ironis.",
            "next": "scene12_n003"
        },
        {
            "id": "scene12_n003",
            "type": "line",
            "speaker": "elenna",
            "expression": "sad",
            "characters": [
                {
                    "characterId": "elenna",
                    "expression": "sad",
                    "position": "center",
                    "isSpeaking": true
                }
            ],
            "text": "{playerName}... aku tahu aku nggak bisa minta maaf dengan kata-kata saja.",
            "next": "scene12_n004"
        },
        {
            "id": "scene12_n004",
            "type": "line",
            "speaker": "{playerName}",
            "expression": "neutral",
            "characters": [
                {
                    "characterId": "elenna",
                    "expression": "sad",
                    "position": "center",
                    "isSpeaking": false
                }
            ],
            "text": "Elenna...",
            "next": "scene12_n005"
        },
        {
            "id": "scene12_n005",
            "type": "line",
            "speaker": "elenna",
            "expression": "sad",
            "characters": [
                {
                    "characterId": "elenna",
                    "expression": "sad",
                    "position": "center",
                    "isSpeaking": true
                }
            ],
            "text": "Aku memanfaatkan kepercayaan keluarga ini. Aku pengkhianat. Tapi aku janji... aku akan memperbaiki semuanya.",
            "next": "scene12_n006"
        },
        {
            "id": "scene12_n006",
            "type": "line",
            "speaker": "elenna",
            "expression": "neutral",
            "characters": [
                {
                    "characterId": "elenna",
                    "expression": "neutral",
                    "position": "center",
                    "isSpeaking": true
                }
            ],
            "text": "Apartemen Om Samuel ada di atas namaku. Perusahaan juga. Aku akan serahkan semuanya ke kak {playerName}.",
            "next": "scene12_n007"
        },
        {
            "id": "scene12_n007",
            "type": "line",
            "speaker": "{playerName}",
            "expression": "smile",
            "characters": [
                {
                    "characterId": "elenna",
                    "expression": "neutral",
                    "position": "center",
                    "isSpeaking": false
                }
            ],
            "text": "(mengelus kepalanya) Yang penting kamu selamat, Elenna.",
            "next": "scene12_n008"
        },
        {
            "id": "scene12_n008",
            "type": "line",
            "speaker": "keyna",
            "expression": "neutral",
            "characters": [
                {
                    "characterId": "keyna",
                    "expression": "neutral",
                    "position": "center",
                    "isSpeaking": true
                }
            ],
            "text": "{playerName}. Ada seseorang yang mau kamu temui.",
            "next": "scene12_n009"
        },
        {
            "id": "scene12_n009",
            "type": "narration",
            "text": "{playerName} berjalan ke teras. Di sana, Keyna berdiri dengan pria tua di kursi roda. Rambutnya putih. Wajahnya... familiar.",
            "next": "scene12_n010"
        },
        {
            "id": "scene12_n010",
            "type": "line",
            "speaker": "{playerName}",
            "expression": "neutral",
            "text": "Kamu... kamu masih hidup?",
            "next": "scene12_n011"
        },
        {
            "id": "scene12_n011",
            "type": "line",
            "speaker": "{playerName}",
            "expression": "serious",
            "text": "(berlutut di hadapan kursi roda) Mereka bilang kamu sudah mati.",
            "next": "scene12_n012"
        },
        {
            "id": "scene12_n012",
            "type": "narration",
            "text": "Secara resmi... ya. Aku 'mati'. Keyna yang menyelamatkanku dari ledakan sepuluh tahun lalu. Aku... bersembunyi. Terlalu pengecut untuk kembali.",
            "next": "scene12_n013"
        },
        {
            "id": "scene12_n013",
            "type": "narration",
            "text": "Setiap malam aku memikirkan kalian. Tapi aku terlalu takut. Azaroth... dia akan membunuh kalian jika aku kembali.",
            "next": "scene12_n014"
        },
        {
            "id": "scene12_n014",
            "type": "line",
            "speaker": "{playerName}",
            "expression": "serious",
            "text": "Sepuluh tahun. Sepuluh tahun kami mengira kamu... meninggalkannya.",
            "next": "scene12_n015"
        },
        {
            "id": "scene12_n015",
            "type": "narration",
            "text": "(meneteskan air mata) Aku tahu. Aku tahu aku bukan paman yang baik. Tapi hari ini... aku di sini.",
            "next": "scene12_n016"
        },
        {
            "id": "scene12_n016",
            "type": "narration",
            "text": "{playerName} memeluk pria tua itu. Dalam pelukannya, ia merasakan kehangatan keluarga yang sudah lama hilang.",
            "next": "scene12_n017"
        },
        {
            "id": "scene12_n017",
            "type": "line",
            "speaker": "keyna",
            "expression": "smile",
            "characters": [
                {
                    "characterId": "keyna",
                    "expression": "smile",
                    "position": "center",
                    "isSpeaking": true
                }
            ],
            "text": "Selamat, {playerName}. Ravenscroft Group sudah kembali. Dan yang lebih penting... keluarga ini kembali.",
            "next": "scene12_n018"
        },
        {
            "id": "scene12_n018",
            "type": "narration",
            "text": "Pagi itu, untuk pertama kalinya dalam sepuluh tahun... mansion Ravenscroft terasa seperti rumah.",
            "next": "scene12_n019"
        },
        {
            "id": "scene12_n019",
            "type": "line",
            "speaker": "{playerName}",
            "expression": "smile",
            "text": "Selamat datang, Paman.",
            "next": "scene12_n020"
        },
        {
            "id": "scene12_n020",
            "type": "narration",
            "text": "Samuel tersenyum untuk pertama kalinya dalam satu dekade.",
            "next": "scene12_end"
        },
        {
            "id": "scene12_end",
            "type": "end",
            "endingId": "good-end"
        }
    ]
}
