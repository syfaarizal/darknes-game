    "nodes": [
        {
            "id": "scene12_bad_n001",
            "type": "narration",
            "text": "Keyna berada di ICU. {playerName} berdiri sendirian di lorong rumah sakit. Tangannya masih berlumuran darah Keyna.",
            "next": "scene12_bad_n002"
        },
        {
            "id": "scene12_bad_n002",
            "type": "line",
            "speaker": "{playerName}",
            "expression": "neutral",
            "text": "...Xyera?",
            "next": "scene12_bad_n003"
        },
        {
            "id": "scene12_bad_n003",
            "type": "narration",
            "text": "Tidak ada jawaban. {playerName} mulai berjalan menyusuri lorong.",
            "next": "scene12_bad_n004"
        },
        {
            "id": "scene12_bad_n004",
            "type": "line",
            "speaker": "{playerName}",
            "expression": "neutral",
            "text": "Xyera... aku harus bagaimana?",
            "next": "scene12_bad_n005"
        },
        {
            "id": "scene12_bad_n005",
            "type": "narration",
            "text": "Masih sunyi. Ia mulai panik.",
            "next": "scene12_bad_n006"
        },
        {
            "id": "scene12_bad_n006",
            "type": "line",
            "speaker": "{playerName}",
            "expression": "neutral",
            "text": "Xyera! Xyera!",
            "next": "scene12_bad_n007"
        },
        {
            "id": "scene12_bad_n007",
            "type": "narration",
            "text": "Elenna berlari menghampiri.",
            "next": "scene12_bad_n008"
        },
        {
            "id": "scene12_bad_n008",
            "type": "line",
            "speaker": "Elenna",
            "expression": "neutral",
            "characters": [
                {
                    "characterId": "Elenna",
                    "expression": "neutral",
                    "position": "center",
                    "isSpeaking": true
                }
            ],
            "text": "Kak! Ada apa?",
            "next": "scene12_bad_n009"
        },
        {
            "id": "scene12_bad_n009",
            "type": "choice",
            "options": [
                {
                    "text": "Di mana Xyera?",
                    "goTo": "scene12_bad_n010"
                },
                {
                    "text": "Tolong panggilkan dia",
                    "goTo": "scene12_bad_n010"
                },
                {
                    "text": "Aku butuh dia...",
                    "goTo": "scene12_bad_n010"
                }
            ]
        },
        {
            "id": "scene12_bad_n010",
            "type": "line",
            "speaker": "Elenna",
            "expression": "neutral",
            "characters": [
                {
                    "characterId": "Elenna",
                    "expression": "neutral",
                    "position": "center",
                    "isSpeaking": true
                }
            ],
            "text": "(menundukkan kepala) ...{playerName}, soal Xyera... dia... dia nggak pernah ada.",
            "next": "scene12_bad_n011"
        },
        {
            "id": "scene12_bad_n011",
            "type": "line",
            "speaker": "{playerName}",
            "expression": "serious",
            "characters": [
                {
                    "characterId": "Elenna",
                    "expression": "neutral",
                    "position": "center",
                    "isSpeaking": false
                }
            ],
            "text": "(membeku) Apa?",
            "next": "scene12_bad_n012"
        },
        {
            "id": "scene12_bad_n012",
            "type": "line",
            "speaker": "Elenna",
            "expression": "neutral",
            "characters": [
                {
                    "characterId": "Elenna",
                    "expression": "neutral",
                    "position": "center",
                    "isSpeaking": true
                }
            ],
            "text": "(ragu) Selama ini... yang kami lihat... dirimu selalu bicara sendiri. Orang yang kamu panggil Xyera itu tidak pernah bisa kami lihat wujudnya.",
            "next": "scene12_bad_n013"
        },
        {
            "id": "scene12_bad_n013",
            "type": "line",
            "speaker": "{playerName}",
            "expression": "serious",
            "characters": [
                {
                    "characterId": "Elenna",
                    "expression": "neutral",
                    "position": "center",
                    "isSpeaking": false
                }
            ],
            "text": "(menggeleng) Tidak, itu tidak mungkin. Dia selalu ada dan selalu menemaniku.",
            "next": "scene12_bad_n014"
        },
        {
            "id": "scene12_bad_n014",
            "type": "line",
            "speaker": "Elenna",
            "expression": "neutral",
            "characters": [
                {
                    "characterId": "Elenna",
                    "expression": "neutral",
                    "position": "center",
                    "isSpeaking": true
                }
            ],
            "text": "{playerName}... Kami udah lama tahu. Kami cuma... ngga mau kamu terluka.",
            "next": "scene12_bad_n015"
        },
        {
            "id": "scene12_bad_n015",
            "type": "narration",
            "text": "{playerName} mundur beberapa langkah. Air matanya mulai jatuh.",
            "next": "scene12_bad_n016"
        },
        {
            "id": "scene12_bad_n016",
            "type": "line",
            "speaker": "{playerName}",
            "expression": "neutral",
            "characters": [
                {
                    "characterId": "Elenna",
                    "expression": "neutral",
                    "position": "center",
                    "isSpeaking": true
                }
            ],
            "text": "Dia nyata. Dia selalu ada...",
            "next": "scene12_bad_n017"
        },
        {
            "id": "scene12_bad_n017",
            "type": "narration",
            "text": "Saat itulah, sosok Xyera muncul di ujung lorong. Tersenyum. Mengulurkan tangan.",
            "next": "scene12_bad_n018"
        },
        {
            "id": "scene12_bad_n018",
            "type": "line",
            "speaker": "Xyera",
            "expression": "smile",
            "characters": [
                {
                    "characterId": "Xyera",
                    "expression": "smile",
                    "position": "center",
                    "isSpeaking": true
                }
            ],
            "text": "Jangan menangis, {playerName}.",
            "next": "scene12_bad_n019"
        },
        {
            "id": "scene12_bad_n019",
            "type": "narration",
            "text": "{playerName} langsung berlari ke arahnya. Elenna hanya melihat {playerName} berlari ke lorong kosong. Ia menangis.",
            "next": "scene12_bad_n020"
        },
        {
            "id": "scene12_bad_n020",
            "type": "line",
            "speaker": "{playerName}",
            "expression": "neutral",
            "characters": [
                {
                    "characterId": "Xyera",
                    "expression": "smile",
                    "position": "center",
                    "isSpeaking": false
                }
            ],
            "text": "(memeluk Xyera) Mereka semua bohong...",
            "next": "scene12_bad_n021"
        },
        {
            "id": "scene12_bad_n021",
            "type": "narration",
            "text": "Elenna menatap {playerName} tidak tega. Layar perlahan menghitam.",
            "next": "scene12_bad_end"
        },
        {
            "id": "scene12_bad_end",
